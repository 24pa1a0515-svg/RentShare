rules_version = '2';
// RentShare – Cloud Firestore security rules.
// Paste these into Firebase console → Firestore Database → Rules → Publish.
// No document is ever created by these rules: the database stays empty until
// real students use the app.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function isMe(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Student profiles. Passwords live only in Firebase Authentication.
    match /users/{uid} {
      allow read: if true;                       // owner names shown on listings
      allow create: if isMe(uid)
                    && request.resource.data.keys().hasOnly(
                         ['name','college','branch','year','email','photo','at'])
                    && request.resource.data.name is string;
      allow update: if isMe(uid);
      allow delete: if false;
    }

    // Listings. Anyone may browse; only the owner may change or remove.
    // The bookings array is the availability ledger written by the owner
    // inside the accept/return transaction.
    match /items/{itemId} {
      allow read: if true;
      allow create: if signedIn() && isMe(request.resource.data.ownerId);
      allow update: if signedIn() && (
                       isMe(resource.data.ownerId)
                       // a renter may only touch nothing here; bookings are
                       // updated by the owner during status changes
                    ) && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isMe(resource.data.ownerId);
    }

    // Rentals. Visible only to the two students involved.
    match /rentals/{rentalId} {
      allow read: if signedIn() && (isMe(resource.data.ownerId) || isMe(resource.data.renterId));
      allow create: if signedIn()
                    && isMe(request.resource.data.renterId)
                    && request.resource.data.renterId != request.resource.data.ownerId
                    && request.resource.data.status == 'Requested'
                    && request.resource.data.reviewed == false;
      // Owner drives the workflow; the renter may only cancel their own
      // pending request or mark it reviewed after completion.
      allow update: if signedIn() && (
                      isMe(resource.data.ownerId)
                      || (isMe(resource.data.renterId) && (
                            (resource.data.status == 'Requested'
                             && request.resource.data.status == 'Cancelled')
                            || (resource.data.status == 'Completed'
                                && request.resource.data.status == 'Completed'
                                && request.resource.data.reviewed == true)
                          ))
                    )
                    && request.resource.data.ownerId == resource.data.ownerId
                    && request.resource.data.renterId == resource.data.renterId;
      allow delete: if false;
    }

    // Chat between two real students. No bots, no automated writers.
    match /conversations/{convoId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn()
                    && request.auth.uid in request.resource.data.members
                    && request.resource.data.members.size() == 2;
      allow update, delete: if false;
    }

    match /messages/{msgId} {
      allow read: if signedIn() && (isMe(resource.data.from) || isMe(resource.data.to));
      allow create: if signedIn()
                    && isMe(request.resource.data.from)
                    && request.resource.data.from != request.resource.data.to
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.read == false;
      // Only the receiver can mark a message as read; text is immutable.
      allow update: if isMe(resource.data.to)
                    && request.resource.data.text == resource.data.text
                    && request.resource.data.read == true;
      allow delete: if false;
    }

    // Reviews are public, written once by the renter of a completed rental.
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if signedIn()
                    && isMe(request.resource.data.userId)
                    && request.resource.data.rating is number
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5
                    && get(/databases/$(database)/documents/rentals/$(request.resource.data.rentalId)).data.renterId == request.auth.uid
                    && get(/databases/$(database)/documents/rentals/$(request.resource.data.rentalId)).data.status == 'Completed';
      allow update, delete: if false;
    }

    // Notifications are created by real app events for the other student,
    // and readable only by their owner.
    match /notifications/{notifId} {
      allow read: if isMe(resource.data.userId);
      allow create: if signedIn()
                    && request.resource.data.read == false
                    && request.resource.data.text is string;
      allow update: if isMe(resource.data.userId)
                    && request.resource.data.text == resource.data.text
                    && request.resource.data.userId == resource.data.userId;
      allow delete: if false;
    }

    // Optional records kept alongside a rental handover / condition check.
    match /handoverRecords/{recId} {
      allow read, create: if signedIn();
      allow update, delete: if false;
    }
    match /conditionRecords/{recId} {
      allow read, create: if signedIn();
      allow update, delete: if false;
    }

    // Nothing else is reachable.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
